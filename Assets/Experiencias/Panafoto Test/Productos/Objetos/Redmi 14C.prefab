  _data:
    _json: '{"declarations":{"Kind":"Object","collection":{"$content":[{"name":"productName","value":{"$content":"Xiaomi
      Redmi 14C | 6.8\" | 128GB | Negro","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"productImage","value":{"$content":"https://back.panafoto.com/media/catalog/product/cache/22adb41f3f66ba957b3b3b7b0df44fe6/1/5/155136-001.jpg","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"productLink","value":{"$content":"https://xiaomistore.com.pa/producto/redmi-14c/?srsltid=AfmBOoppP7Usr2trJ8PnbQA1fPRGpoXHfuiIi4g8tMgUywxeaKYgXU5b","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"warrantyYears","value":{"$content":1,"$type":"System.Int32"},"typeHandle":{"Identification":"System.Int32,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"techImage","value":{"$content":"https://back.panafoto.com/media/catalog/product/cache/22adb41f3f66ba957b3b3b7b0df44fe6/1/5/155136-002.jpg","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"energyImage","value":{"$content":"https://back.panafoto.com/media/catalog/product/cache/22adb41f3f66ba957b3b3b7b0df44fe6/1/5/155136-003.jpg","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"durabilityImage","value":{"$content":"https://back.panafoto.com/media/catalog/product/cache/22adb41f3f66ba957b3b3b7b0df44fe6/1/5/155136-004.jpg","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"warrantyText","value":{"$content":"Incluye
      1 a\u00f1o de garant\u00eda, asegurando soporte t\u00e9cnico y cobertura en
      caso de defectos de f\u00e1brica, lo que brinda tranquilidad al usuario.  ","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"techText","value":{"$content":"El
      Redmi 14C est\u00e1 equipado con un procesador octa-core que asegura un rendimiento
      fluido para tareas cotidianas. Su almacenamiento interno de 128GB, ampliable
      mediante tarjeta microSD, permite guardar una gran cantidad de datos. Adem\u00e1s,
      cuenta con una pantalla HD+ de 6.7 pulgadas, ideal para una experiencia visual
      inmersiva.  ","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"energyText","value":{"$content":"Incorpora
      una bater\u00eda de 5000mAh con optimizaci\u00f3n de consumo energ\u00e9tico
      que ofrece autonom\u00eda para todo el d\u00eda, reduciendo la necesidad de
      cargas frecuentes.  ","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"durabilityText","value":{"$content":"Dise\u00f1o
      elegante con materiales resistentes que combinan pl\u00e1stico de alta calidad
      y acabados texturizados, lo que garantiza un uso confiable y prolongado. Su
      construcci\u00f3n robusta protege el dispositivo contra desgastes del uso diario.      
      ","$type":"System.String"},"typeHandle":{"Identification":"System.String, mscorlib,
      Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"productAchievement","value":{"$content":"41e8511b-cb46-43f3-ba09-95ce3917f570","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"experienceID","value":{"$content":"8d890244-e95d-464c-a53c-198473571d2b","$type":"System.String"},"typeHandle":{"Identification":"System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"imageComponent","value":{"$content":0,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"Ilikeit.UI.IlikeitWebImage,
      Ilikeit.UI, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"nameText","value":{"$content":1,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"TMPro.TextMeshProUGUI,
      Unity.TextMeshPro, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"tTSAudio","value":{"$content":2,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.AudioSource,
      UnityEngine.AudioModule, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"fXAudio","value":{"$content":3,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.AudioSource,
      UnityEngine.AudioModule, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"panelPrincipal","value":{"$content":4,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.GameObject,
      UnityEngine.CoreModule, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"panelGarantia","value":{"$content":5,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.GameObject,
      UnityEngine.CoreModule, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"panelOtros","value":{"$content":6,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.GameObject,
      UnityEngine.CoreModule, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"},{"name":"imagenGarantia","value":{"$content":7,"$type":"UnityEngine.Object"},"typeHandle":{"Identification":"UnityEngine.UI.Image,
      UnityEngine.UI, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null","$version":"A"},"$version":"A"}],"$version":"A"},"$version":"A"}}'
